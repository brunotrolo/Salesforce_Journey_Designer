{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npx vite *)",
      "Bash(npx @salesforce-ux/slds-linter@latest lint *)",
      "Bash(npm test *)",
      "Bash(npx jest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-prototype.mjs",
            "statusMessage": "verificando build/lint/scorecard do protótipo (sf-html-prototyper.md, passo 6)"
          }
        ]
      }
    ]
  }
}
